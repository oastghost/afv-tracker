# AFV Tracker — Server Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank to use local SQLite (good for testing)
DATABASE_URL=

# MySQL / MariaDB (your friend's HeidiSQL database):
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME

# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is set automatically by Railway / Render — don't set it manually there
PORT=8000
